"""SatuSehat Integration Service - Handles FHIR API operations"""
import requests
from core.config import Config

class SatusehatService:
    """Service for SatuSehat FHIR API integration."""
    
    @staticmethod
    def fetch_token():
        """
        Fetch access token from SatuSehat OAuth2.
        
        Returns:
            tuple: (access_token, error_message or None)
        """
        token_url = f"{Config.AUTH_URL}/accesstoken?grant_type=client_credentials"
        try:
            resp = requests.post(
                token_url,
                data={
                    "client_id": Config.CLIENT_ID,
                    "client_secret": Config.CLIENT_SECRET
                },
                timeout=15
            )
            resp.raise_for_status()
            return resp.json().get("access_token"), None
        except Exception as e:
            return None, str(e)

    @staticmethod
    def fhir_get(url, token):
        """
        Helper method to perform GET request to FHIR SatuSehat.
        
        Args:
            url (str): FHIR API endpoint URL
            token (str): Access token
            
        Returns:
            tuple: (response_json, status_code)
        """
        headers = {
            "Authorization": f"Bearer {token}",
            "Accept": "application/fhir+json"
        }
        try:
            resp = requests.get(url, headers=headers, timeout=20)
            return resp.json(), resp.status_code
        except Exception as e:
            return {"error": str(e)}, 502

    @staticmethod
    def get_imaging_study_id(accession_num):
        """
        Get ImagingStudy ID from SatuSehat based on Accession Number.
        
        Args:
            accession_num (str): Accession Number
            
        Returns:
            tuple: (dict with imaging_study_id and patient_reference, error message or None)
        """
        token, err = SatusehatService.fetch_token()
        if err:
            return None, err
        
        identifier_system = f"http://sys-ids.kemkes.go.id/acsn/{Config.ORG_ID}"
        url = f"{Config.BASE_URL}/ImagingStudy?identifier={identifier_system}|{accession_num}"
        
        data, status = SatusehatService.fhir_get(url, token)
        
        if status != 200:
            return None, str(data)

        if data.get("resourceType") == "Bundle":
            entries = data.get("entry") or []
            for e in entries:
                res = e.get("resource") or {}
                if res.get("resourceType") == "ImagingStudy":
                    return {
                        "imagingStudy_id": res.get("id"),
                        "patient_reference": res.get("subject", {}).get("reference")
                    }, None

        return None, "No ImagingStudy found for this Accession Number"
